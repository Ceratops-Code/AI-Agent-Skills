{
  "version": 1,
  "suites": {
    "design-document-lifecycle": {
      "pytest": [
        "tests/design_document_lifecycle"
      ],
      "depends_on": []
    },
    "tool_manager": {
      "pytest": [
        "tests/tool_manager"
      ],
      "depends_on": []
    },
    "credit-analysis": {
      "pytest": [
        "tests/credit_analysis"
      ],
      "depends_on": []
    },
    "governance-lifecycle": {
      "pytest": [
        "tests/governance_lifecycle"
      ],
      "depends_on": []
    },
    "openai-docs": {
      "pytest": [
        "tests/openai_docs"
      ],
      "depends_on": []
    },
    "repository-lifecycle": {
      "pytest": [
        "tests/repository_lifecycle"
      ],
      "depends_on": []
    },
    "skill-lifecycle": {
      "pytest": [
        "tests/skill_lifecycle"
      ],
      "depends_on": []
    },
    "task-lifecycle": {
      "pytest": [
        "tests/task_lifecycle"
      ],
      "depends_on": []
    },
    "test-infrastructure": {
      "pytest": [
        "tests/test_infrastructure"
      ],
      "depends_on": []
    }
  },
  "rules": [
    {
      "id": "design-document-lifecycle-source",
      "paths": [
        "skills/design-document-lifecycle/**"
      ],
      "suites": [
        "design-document-lifecycle"
      ]
    },
    {
      "id": "tool_manager_source",
      "paths": [
        ".codex/config.toml",
        "tools/**",
        "scripts/deploy-tool-manager.py"
      ],
      "suites": [
        "tool_manager"
      ]
    },
    {
      "id": "tool-lifecycle-source",
      "paths": ["skills/ceratops-tool-lifecycle/**"],
      "suites": ["tool_manager", "repository-lifecycle"]
    },
    {
      "id": "credit-analysis-source",
      "paths": [
        "skills/ceratops-credit-savings-analysis/**",
        "skills/ceratops-misunderstanding-audit/**"
      ],
      "suites": [
        "credit-analysis"
      ]
    },
    {
      "id": "governance-lifecycle-source",
      "paths": [
        "skills/ceratops-governance-lifecycle/**"
      ],
      "suites": [
        "governance-lifecycle"
      ]
    },
    {
      "id": "openai-docs-source",
      "paths": [
        "skills/openai-docs-managed/**"
      ],
      "suites": [
        "openai-docs"
      ]
    },
    {
      "id": "repository-lifecycle-source",
      "paths": [
        "skills/ceratops-repo-lifecycle/**",
        "sdlc/**"
      ],
      "suites": [
        "repository-lifecycle"
      ]
    },
    {
      "id": "skill-lifecycle-source",
      "paths": [
        "scripts/deploy-skills.py",
        "skills/ceratops-skill-lifecycle/**"
      ],
      "suites": [
        "repository-lifecycle",
        "skill-lifecycle"
      ]
    },
    {
      "id": "task-lifecycle-source",
      "paths": [
        "skills/ceratops-task-lifecycle/**"
      ],
      "suites": [
        "task-lifecycle"
      ]
    },
    {
      "id": "test-hook-source",
      "paths": [
        "scripts/deploy-hooks.py",
        "hooks/*.py"
      ],
      "suites": [
        "test-infrastructure"
      ]
    }
  ],
  "full_suite_paths": [
    ".github/dependabot.yml",
    ".github/workflows/**",
    "AGENTS.history.json",
    "AGENTS.md",
    "package-lock.json",
    "package.json",
    "pyproject.toml",
    "scripts/testing/run-tests.py",
    "scripts/testing/runner_requests.py",
    "scripts/testing/pytest-diagnostics.py",
    "scripts/testing/pytest-environment.py",
    "scripts/validate-repository.py",
    "skills/ceratops-automation-run/**",
    "skills/ceratops-code-consistency-audit/**",
    "skills/codex-desktop-upgrade/**",
    "skills/sections/**",
    "skills/skill-sections.json",
    "tests/__init__.py",
    "tests/conftest.py",
    "tests/support/**",
    "tests/test-impact.json",
    "scripts/pyproject.toml",
    "scripts/uv.lock"
  ],
  "ignored_paths": [
    {
      "id": "documentation-only",
      "paths": [
        ".github/CODEOWNERS",
        ".github/ISSUE_TEMPLATE/**",
        ".github/pull_request_template.md",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "docs/design-draft.md",
        "LICENSE",
        "README.md",
        "hooks/README.md"
      ],
      "reason": "These files contain repository documentation or contribution metadata and cannot change executable behavior."
    }
  ],
  "unmapped_production": "error"
}
