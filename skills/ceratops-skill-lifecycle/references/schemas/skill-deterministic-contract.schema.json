{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill deterministic contract",
  "description": "Closed declaration format consumed by check_skill_deterministic_contract. Execution paths and commands are checked against supported helpers without executing contract-supplied code. Annotation-only fields describe evidence or review intent and do not configure runtime behavior.",
  "type": "object",
  "required": [
    "$schema",
    "contract_format_version",
    "kind",
    "name",
    "captured_on",
    "source_files",
    "parameters",
    "required_scopes",
    "source_docs_ref",
    "source_doc_scopes",
    "non_deterministic_review_file",
    "remediation_policy",
    "execution",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "../schemas/skill-deterministic-contract.schema.json"
    },
    "contract_format_version": {
      "const": 1
    },
    "kind": {
      "const": "skill_design_contract"
    },
    "name": {
      "const": "ceratops_skill_deterministic_contract"
    },
    "captured_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Annotation only: capture date."
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "description": "Annotation only: source attribution, not executable source evidence.",
      "items": {
        "type": "object",
        "required": [
          "path",
          "lines"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "lines": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "parameters": {
      "type": "object",
      "description": "Annotation only: describes invocation examples; does not set CLI defaults or requirements.",
      "required": [
        "skill_name",
        "skill_dir",
        "validation_mode"
      ],
      "additionalProperties": false,
      "properties": {
        "skill_name": {
          "type": "object",
          "required": [
            "type",
            "required"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "string"
            },
            "required": {
              "const": true
            }
          }
        },
        "skill_dir": {
          "type": "object",
          "required": [
            "type",
            "required",
            "default_from"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "string"
            },
            "required": {
              "const": false
            },
            "default_from": {
              "const": "skills/${skill_name}"
            }
          }
        },
        "validation_mode": {
          "type": "object",
          "required": [
            "type",
            "required",
            "default",
            "allowed"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "string"
            },
            "required": {
              "const": false
            },
            "default": {
              "const": "full"
            },
            "allowed": {
              "const": [
                "skill",
                "sections",
                "full"
              ]
            }
          }
        }
      }
    },
    "required_scopes": {
      "const": [
        "skill"
      ],
      "description": "Annotation only: review scope."
    },
    "source_docs_ref": {
      "const": "skill-contract-source-docs.json",
      "description": "Validator checks the local evidence registry exists."
    },
    "source_doc_scopes": {
      "const": [
        "skill"
      ],
      "description": "Annotation only: evidence-review scope."
    },
    "non_deterministic_review_file": {
      "const": "skill-nondeterministic-contract.json",
      "description": "Validated companion contract, consumed by check_skill_nondeterministic_contract."
    },
    "remediation_policy": {
      "type": "object",
      "description": "Validated report-only classification: every deterministic check must be assigned to AI review; no executable auto-repair is supported.",
      "required": [
        "default",
        "apply_flag",
        "auto_apply_check_ids",
        "ai_agent_check_ids",
        "destructive_or_irreversible"
      ],
      "additionalProperties": false,
      "properties": {
        "default": {
          "const": "report_only"
        },
        "apply_flag": {
          "const": null
        },
        "auto_apply_check_ids": {
          "const": []
        },
        "ai_agent_check_ids": {
          "type": "array",
          "items": {
            "enum": [
              "skill.repository_identity_and_profile",
              "skill.bootstrap_version_consistency",
              "skill.frontmatter_and_layout",
              "skill.metadata_alignment",
              "skill.shared_section_generation",
              "skill.multi_action_contract",
              "skill.resource_layout",
              "skill.runtime_payload_portability",
              "skill.runtime_source_ownership",
              "skill.public_doc_alignment",
              "skill.private_path_and_secret_absence",
              "skill.contract_reference_alignment",
              "skill.governance_consistency_audit"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "destructive_or_irreversible": {
          "const": "always_report_only"
        }
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "source_validator",
        "skill_validation_command",
        "full_validation_command",
        "section_validation_command",
        "runtime_inventory_command",
        "result_contract"
      ],
      "additionalProperties": false,
      "properties": {
        "source_validator": {
          "type": "string",
          "minLength": 1,
          "description": "Validator checks the canonical source-helper path and file existence."
        },
        "skill_validation_command": {
          "type": "string",
          "minLength": 1,
          "description": "Validator checks the exact supported source-helper argv for skill mode."
        },
        "full_validation_command": {
          "type": "string",
          "minLength": 1,
          "description": "Validator checks the exact supported source-helper argv for full mode."
        },
        "section_validation_command": {
          "type": "string",
          "minLength": 1,
          "description": "Validator checks the exact supported source-helper argv for sections mode."
        },
        "runtime_inventory_command": {
          "type": "string",
          "minLength": 1,
          "description": "Validator checks the exact supported inventory-helper argv and file existence."
        },
        "result_contract": {
          "type": "string",
          "minLength": 1,
          "description": "Annotation only: describes observable CLI results; behavior tests establish the result contract."
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "deterministic_evidence",
          "pass_condition"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "skill.repository_identity_and_profile",
              "skill.bootstrap_version_consistency",
              "skill.frontmatter_and_layout",
              "skill.metadata_alignment",
              "skill.shared_section_generation",
              "skill.multi_action_contract",
              "skill.resource_layout",
              "skill.runtime_payload_portability",
              "skill.runtime_source_ownership",
              "skill.public_doc_alignment",
              "skill.private_path_and_secret_absence",
              "skill.contract_reference_alignment",
              "skill.governance_consistency_audit"
            ],
            "description": "Validated identifier mapped to the report-only remediation policy."
          },
          "category": {
            "enum": [
              "source",
              "metadata",
              "runtime",
              "docs",
              "safety",
              "contracts",
              "governance"
            ],
            "description": "Annotation only: review grouping."
          },
          "deterministic_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true,
            "description": "Annotation only: evidence locations; never evaluated as code or source assertions."
          },
          "pass_condition": {
            "type": "string",
            "minLength": 1,
            "description": "Annotation only: describes the intended result established by owning validators and behavior tests."
          }
        }
      }
    }
  }
}
