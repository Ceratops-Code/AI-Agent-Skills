{
  "contract_format_version": 1,
  "kind": "ceratops_compatibility_contract",
  "description": "Internal Ceratops repository structure and compatibility-generation defaults. Structural success is separate from the companion behavioral review. This contract stays in the lifecycle skill; targets own their generated files and dependencies.",
  "non_deterministic_review_file": "ceratops-compatibility-nondeterministic-contract.json",
  "surfaces": {
    "validator": {
      "path": "scripts/validate-repository.py",
      "template": "validate-repository.py.tmpl",
      "required": "always"
    },
    "workflow": {
      "path": ".github/workflows/validate.yml",
      "template": "validate.yml.tmpl",
      "required": "always"
    },
    "sdlc": {
      "path": "sdlc/sdlc.yml",
      "template": "sdlc.yml.tmpl",
      "required": "always"
    },
    "skill_manifest": {
      "path": "skills/skill-sections.json",
      "template": "skill-sections.json.tmpl",
      "required": "with_skills"
    },
    "skill_bootstrap": {
      "path": "scripts/deploy-skills.py",
      "template": "deploy-skills.py.tmpl",
      "required": "with_skills"
    },
    "sdlc_runner": {
      "path": "scripts/sdlc.py",
      "template": "sdlc.py.tmpl",
      "required": "always"
    },
    "validation_project": {
      "path": "scripts/pyproject.toml",
      "template": "validation-pyproject.toml.tmpl",
      "required": "always"
    },
    "python_test_runner": {
      "path": "scripts/run-tests.py",
      "template": "run-tests.py.tmpl",
      "required": "with_python_tests"
    }
  },
  "ci_required_arguments": [
    "--validate",
    "--ci",
    "--evidence-file"
  ],
  "manifest_profiles": [
    "ceratops",
    "ceratops-compatible"
  ],
  "generated_manifest_profile": "ceratops-compatible",
  "managed_skill_operations": {
    "validate": {
      "ceratops-managed": {
        "handoff": "ceratops-skill-lifecycle/source-validate"
      }
    },
    "deploy-local": {
      "ceratops-managed": {
        "handoff": "ceratops-skill-lifecycle/deploy"
      },
      "standalone": {
        "steps": [
          {
            "run": [
              "uv",
              "run",
              "--project",
              "scripts",
              "--locked",
              "python",
              "scripts/deploy-skills.py"
            ]
          }
        ]
      }
    },
    "tests": {
      "none": {
        "no-op": "No skill-specific test command is declared; repository tests remain separately selectable."
      }
    }
  },
  "sdlc_version": 3,
  "runtime": {
    "project": "scripts",
    "lockfile": "scripts/uv.lock",
    "environment": "scripts/.venv",
    "payload_root": "scripts/runtime",
    "ignored_paths": [
      ".venv/",
      "**/__pycache__/"
    ],
    "payloads": [
      "scripts/repository_operation.py",
      "scripts/sdlc_handoffs.py",
      "scripts/sdlc_results.py",
      "scripts/github_pr_workflow/command.py",
      "scripts/github_contract_engine/github_api.py",
      "scripts/ceratops_repo_compatibility_engine/sdlc_contract_validation.py",
      "references/schemas/sdlc.yml.schema.json",
      "references/schemas/sdlc.v1.schema.json",
      "references/schemas/sdlc.v2.schema.json"
    ]
  },
  "python_test_detection": {
    "patterns": [
      "test_*.py",
      "*_test.py",
      "tests.py"
    ],
    "configuration_files": [
      "pytest.toml",
      ".pytest.toml",
      "pytest.ini",
      ".pytest.ini",
      "conftest.py"
    ],
    "excluded_directories": [
      ".git",
      ".venv",
      "venv",
      "node_modules",
      "__pycache__",
      "build",
      "dist"
    ]
  },
  "dependency_updates": {
    "package-ecosystem": "uv",
    "directory": "/scripts",
    "schedule": {
      "interval": "weekly"
    }
  }
}
