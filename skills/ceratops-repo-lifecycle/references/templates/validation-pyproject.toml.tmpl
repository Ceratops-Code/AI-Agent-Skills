[project]
name = "repository-tools"
version = "0.0.0"
requires-python = ">=3.11"
dependencies = __DEPENDENCIES__

[tool.uv]
package = false

[tool.uv.workspace]
members = []

[tool.ruff]
target-version = "py311"
extend-exclude = ["scripts/runtime"]

[tool.ruff.lint]
select = ["E", "F", "I", "B"]
ignore = ["E501"]

[tool.mypy]
files = ["."]
exclude = ["(^|/)\\.venv/", "^scripts/runtime/"]
ignore_missing_imports = true
check_untyped_defs = true
warn_unused_configs = true
