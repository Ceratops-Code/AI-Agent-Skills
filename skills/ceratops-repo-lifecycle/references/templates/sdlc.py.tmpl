#!/usr/bin/env python3
"""Run this repository's copied SDLC engine inside its declared uv environment.

Usage from the repository root:
uv run --project scripts --locked python scripts/sdlc.py --validate
The copied engine is usable without installed skills. CI adds --ci so handoffs
are never executed. uv owns environment creation and dependency installation.
"""

from __future__ import annotations

# Bootstrap precedes dependency imports; imported modules keep their caller's Python.
# ruff: noqa: E402
if __name__ == "__main__":
    import pathlib as _bootstrap_pathlib
    import runpy as _bootstrap_runpy

    _bootstrap = next((parent / "scripts/python_environment.py"
                       for parent in _bootstrap_pathlib.Path(__file__).resolve().parents
                       if (parent / "scripts/python_environment.py").is_file()), None)
    if _bootstrap is None:
        raise SystemExit(
            "error: missing scripts/python_environment.py; apply repository setup first"
        )
    _bootstrap_runpy.run_path(str(_bootstrap))["ensure_environment"](__file__)

import pathlib
import runpy
import sys

ROOT = pathlib.Path(__file__).resolve().parents[1]
RUNTIME = ROOT / "scripts/runtime/scripts"
sys.dont_write_bytecode = True
sys.path.insert(0, str(RUNTIME))

if __name__ == "__main__":
    sys.argv[1:1] = ["--repo-root", str(ROOT)]
    runpy.run_path(str(RUNTIME / "repository_operation.py"), run_name="__main__")
