#!/usr/bin/env python3
"""Run this repository's copied SDLC engine inside its declared uv environment.

Usage from the repository root:
uv run --locked scripts/sdlc.py --validate
The copied engine is usable without installed skills. CI adds --ci so handoffs
are never executed. uv owns environment creation and dependency installation.
"""

from __future__ import annotations

import pathlib
import runpy
import sys

ROOT = pathlib.Path(__file__).resolve().parents[1]
RUNTIME = ROOT / "scripts/runtime/scripts"
sys.dont_write_bytecode = True
sys.path.insert(0, str(RUNTIME))

if __name__ == "__main__":
    sys.argv[1:1] = ["--repo-root", str(ROOT)]
    runpy.run_path(str(RUNTIME / "repository_operation.py"), run_name="__main__")
