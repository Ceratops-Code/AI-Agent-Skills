{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ceratops-Code/AI-Agent-Skills/schemas/sdlc.v2.schema.json",
  "title": "Ceratops repository SDLC contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "kind": {
      "const": "ceratops-sdlc"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "deliverables": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/deliverable"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prerequisites": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/prerequisite"
          }
        },
        "bootstrap": {
          "$ref": "#/$defs/operations"
        },
        "validate": {
          "$ref": "#/$defs/operations"
        }
      }
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "validate": {
          "$ref": "#/$defs/operations"
        },
        "deploy-local": {
          "$ref": "#/$defs/operations"
        },
        "publish": {
          "$ref": "#/$defs/operations"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "prerequisite": {
      "description": "Annotation-only setup requirements for the calling agent; never commands inferred from executable names, channels, or included tools.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "version-from": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "key"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "includes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "windows",
              "linux",
              "macos"
            ]
          }
        }
      }
    },
    "operations": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/operation"
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "steps"
          ]
        },
        {
          "required": [
            "handoff"
          ]
        }
      ],
      "properties": {
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "parameters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "handoff": {
          "description": "Advisory routing to a skill/action or workflow. Not executable instructions, a receipt protocol, or proof of completion.",
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run"
      ],
      "properties": {
        "run": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "description": "External-artifact record shape. Deterministic validation enforces these fields and their basic types; ND.artifact.identity-contract-fit reviews whether their detailed text is semantically accurate for the real artifact.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "registry",
        "package_or_image_name",
        "version_source",
        "release_policy",
        "tag_style",
        "changelog_source",
        "post_publish_consumer_check"
      ],
      "properties": {
        "artifact_type": {
          "description": "Artifact type declared by the lifecycle artifact type system.",
          "type": "string",
          "minLength": 1
        },
        "registry": {
          "description": "Registry host or lifecycle target such as github_release or pages.",
          "type": "string",
          "minLength": 1
        },
        "package_or_image_name": {
          "description": "External package, image, release asset, module, chart, or site name.",
          "type": "string",
          "minLength": 1
        },
        "version_source": {
          "description": "Manifest, Git tag, release tag, package metadata, or another explicitly approved version source.",
          "type": "string",
          "minLength": 1
        },
        "release_policy": {
          "description": "Publication policy such as manual, tag-driven, workflow-driven, no-artifact, or another explicitly approved value.",
          "type": "string",
          "minLength": 1
        },
        "tag_style": {
          "description": "Tag format such as semver, v-prefix-semver, calendar, SHA, digest, or another explicitly approved value.",
          "type": "string",
          "minLength": 1
        },
        "changelog_source": {
          "description": "CHANGELOG.md, GitHub release notes, package metadata, or another explicitly approved changelog source.",
          "type": "string",
          "minLength": 1
        },
        "post_publish_consumer_check": {
          "description": "Command or endpoint used to verify consumers can fetch and use the published artifact.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
