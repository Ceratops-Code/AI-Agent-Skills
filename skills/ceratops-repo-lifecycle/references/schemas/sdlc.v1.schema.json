{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ceratops-Code/AI-Agent-Skills/schemas/sdlc.v1.schema.json",
  "title": "Ceratops repository SDLC contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind"
  ],
  "anyOf": [
    {
      "required": [
        "deploy"
      ]
    },
    {
      "required": [
        "release"
      ]
    }
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "ceratops-sdlc"
    },
    "deploy": {
      "$ref": "#/$defs/deploy"
    },
    "release": {
      "$ref": "#/$defs/release"
    }
  },
  "$defs": {
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations"
      ],
      "properties": {
        "operations": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/deployOperation"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations"
      ],
      "properties": {
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "operations": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/releaseOperation"
          }
        }
      }
    },
    "artifact": {
      "description": "External-artifact record shape. Deterministic validation enforces these fields and their basic types; ND.artifact.identity-contract-fit reviews whether their detailed text is semantically accurate for the real artifact.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "registry",
        "package_or_image_name",
        "version_source",
        "release_policy",
        "tag_style",
        "changelog_source",
        "post_publish_consumer_check"
      ],
      "properties": {
        "artifact_type": {
          "description": "Artifact type declared by the lifecycle artifact type system.",
          "type": "string",
          "minLength": 1
        },
        "registry": {
          "description": "Registry host or lifecycle target such as github_release or pages.",
          "type": "string",
          "minLength": 1
        },
        "package_or_image_name": {
          "description": "External package, image, release asset, module, chart, or site name.",
          "type": "string",
          "minLength": 1
        },
        "version_source": {
          "description": "Manifest, Git tag, release tag, package metadata, or another explicitly approved version source.",
          "type": "string",
          "minLength": 1
        },
        "release_policy": {
          "description": "Publication policy such as manual, tag-driven, workflow-driven, no-artifact, or another explicitly approved value.",
          "type": "string",
          "minLength": 1
        },
        "tag_style": {
          "description": "Tag format such as semver, v-prefix-semver, calendar, SHA, digest, or another explicitly approved value.",
          "type": "string",
          "minLength": 1
        },
        "changelog_source": {
          "description": "CHANGELOG.md, GitHub release notes, package metadata, or another explicitly approved changelog source.",
          "type": "string",
          "minLength": 1
        },
        "post_publish_consumer_check": {
          "description": "Command or endpoint used to verify consumers can fetch and use the published artifact.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deployOperation": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "steps"
          ]
        },
        {
          "required": [
            "handoff"
          ]
        }
      ],
      "properties": {
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "steps": {
          "$ref": "#/$defs/steps"
        },
        "handoff": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?/[a-z][a-z0-9-]*$"
        }
      }
    },
    "releaseOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "steps": {
          "$ref": "#/$defs/steps"
        }
      }
    },
    "parameters": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "run"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "run": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$comment": "Version 1 schema recovered from f49e575; used unchanged through f671d9b. Version-specific data support only."
}
