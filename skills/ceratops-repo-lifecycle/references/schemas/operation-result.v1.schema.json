{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ceratops-Code/Ceratops-AI-Agents-Kit/schemas/operation-result.v1.schema.json",
  "title": "Ceratops operation result v1",
  "description": "Canonical validation, test, build, and deployment result records emitted by repository SDLC operations.",
  "oneOf": [
    {
      "$ref": "#/$defs/validationResult"
    },
    {
      "$ref": "#/$defs/testAggregateResult"
    },
    {
      "$ref": "#/$defs/testGroupResult"
    },
    {
      "$ref": "#/$defs/buildResult"
    },
    {
      "$ref": "#/$defs/buildReceipt"
    },
    {
      "$ref": "#/$defs/deploymentResult"
    }
  ],
  "$defs": {
    "schemaIdentifier": {
      "enum": [
        "ceratops-repository-stage-result.v1",
        "ceratops-build-result.v1",
        "ceratops-build-result.v2",
        "ceratops-deployment-result.v1"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentSha256",
        "sourceCommit"
      ],
      "properties": {
        "contentSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceCommit": {
          "oneOf": [
            {
              "$ref": "#/$defs/gitCommit"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "stageStatus": {
      "enum": [
        "running",
        "passed",
        "failed",
        "blocked"
      ]
    },
    "terminalStatus": {
      "enum": [
        "passed",
        "failed",
        "blocked"
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed",
            "blocked"
          ]
        },
        "exitCode": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "validationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "stage",
        "status",
        "source",
        "checks",
        "evidence"
      ],
      "properties": {
        "schema": {
          "const": "ceratops-repository-stage-result.v1"
        },
        "stage": {
          "const": "validation"
        },
        "status": {
          "$ref": "#/$defs/stageStatus"
        },
        "source": {
          "$ref": "#/$defs/sourceIdentity"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "evidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/relativePath"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "groupReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/stageStatus"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "testAggregateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "stage",
        "status",
        "source",
        "groups"
      ],
      "properties": {
        "schema": {
          "const": "ceratops-repository-stage-result.v1"
        },
        "stage": {
          "const": "tests"
        },
        "status": {
          "$ref": "#/$defs/stageStatus"
        },
        "source": {
          "$ref": "#/$defs/sourceIdentity"
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/groupReference"
          }
        }
      }
    },
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped"
          ]
        },
        "reason": {
          "type": "string"
        },
        "difference": {
          "type": "string"
        }
      }
    },
    "testSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "passed",
        "failed",
        "skipped"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "testGroupResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "stage",
        "group",
        "status",
        "source",
        "command",
        "summary",
        "cases",
        "evidence"
      ],
      "properties": {
        "schema": {
          "const": "ceratops-repository-stage-result.v1"
        },
        "stage": {
          "const": "tests"
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/stageStatus"
        },
        "source": {
          "$ref": "#/$defs/sourceIdentity"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "$ref": "#/$defs/testSummary"
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/testCase"
          }
        },
        "evidence": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "buildResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "artifact"
      ],
      "properties": {
        "schema": {
          "const": "ceratops-build-result.v1"
        },
        "status": {
          "$ref": "#/$defs/terminalStatus"
        },
        "artifact": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "artifact": {
                "$ref": "#/$defs/artifact"
              }
            }
          }
        }
      ]
    },
    "buildSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "sourceCommit",
        "releaseUnit",
        "channel",
        "version",
        "target"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "sourceCommit": {
          "$ref": "#/$defs/gitCommit"
        },
        "releaseUnit": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "channel": {
          "enum": [
            "alpha",
            "beta",
            "release"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      }
    },
    "bundlePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\:\\u0000-\\u001f\\u007f]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "(^|/)\\.{1,2}(/|$)"
          },
          {
            "pattern": "//|/$"
          }
        ]
      }
    },
    "bundleFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "path": {
          "$ref": "#/$defs/bundlePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "buildArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deliverable",
        "type",
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "deliverable": {
          "type": "string",
          "pattern": "^deliverables\\.(packages|apps|mcp-servers|skills|hooks)\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "path": {
          "$ref": "#/$defs/bundlePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "buildFileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/bundlePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "buildDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "artifacts"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/buildSelection"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/buildArtifact"
          }
        }
      }
    },
    "buildTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "artifacts",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked",
            "skipped"
          ]
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/buildFileReference"
          }
        },
        "evidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/buildFileReference"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "passed",
                  "failed"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "$ref": "#/$defs/buildFileReference"
              }
            }
          }
        }
      ]
    },
    "buildReceipt": {
      "description": "A release-unit build inventory. Verification establishes file integrity only; build/test statuses remain producer claims and never authorize deployment.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "identity",
        "artifacts",
        "dependencies",
        "supportingFiles",
        "tests"
      ],
      "properties": {
        "schema": {
          "const": "ceratops-build-result.v2"
        },
        "status": {
          "$ref": "#/$defs/terminalStatus"
        },
        "identity": {
          "$ref": "#/$defs/buildSelection"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/buildArtifact"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/buildDependency"
          }
        },
        "supportingFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bundleFile"
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/buildTest"
          }
        }
      }
    },
    "deploymentResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "target",
        "artifact"
      ],
      "properties": {
        "schema": {
          "const": "ceratops-deployment-result.v1"
        },
        "status": {
          "$ref": "#/$defs/terminalStatus"
        },
        "target": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "artifact": {
                "$ref": "#/$defs/artifact"
              }
            }
          }
        }
      ]
    }
  }
}
