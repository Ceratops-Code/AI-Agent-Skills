{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ceratops-Code/AI-Agent-Skills/schemas/operation-result.v1.schema.json",
  "title": "Ceratops operation result v1",
  "description": "Canonical validation, test, build, and deployment result records emitted by repository SDLC operations.",
  "oneOf": [
    {
      "$ref": "#/$defs/validationResult"
    },
    {
      "$ref": "#/$defs/testAggregateResult"
    },
    {
      "$ref": "#/$defs/testGroupResult"
    },
    {
      "$ref": "#/$defs/buildResult"
    },
    {
      "$ref": "#/$defs/deploymentResult"
    }
  ],
  "$defs": {
    "schemaIdentifier": {
      "enum": [
        "ceratops-repository-stage-result.v1",
        "ceratops-build-result.v1",
        "ceratops-deployment-result.v1"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentSha256",
        "sourceCommit"
      ],
      "properties": {
        "contentSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceCommit": {
          "oneOf": [
            {
              "$ref": "#/$defs/gitCommit"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "stageStatus": {
      "enum": [
        "running",
        "passed",
        "failed",
        "blocked"
      ]
    },
    "terminalStatus": {
      "enum": [
        "passed",
        "failed",
        "blocked"
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed",
            "blocked"
          ]
        },
        "exitCode": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "validationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "stage",
        "status",
        "source",
        "checks",
        "evidence"
      ],
      "properties": {
        "schema": {
          "const": "ceratops-repository-stage-result.v1"
        },
        "stage": {
          "const": "validation"
        },
        "status": {
          "$ref": "#/$defs/stageStatus"
        },
        "source": {
          "$ref": "#/$defs/sourceIdentity"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "evidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/relativePath"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "groupReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/stageStatus"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "testAggregateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "stage",
        "status",
        "source",
        "groups"
      ],
      "properties": {
        "schema": {
          "const": "ceratops-repository-stage-result.v1"
        },
        "stage": {
          "const": "tests"
        },
        "status": {
          "$ref": "#/$defs/stageStatus"
        },
        "source": {
          "$ref": "#/$defs/sourceIdentity"
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/groupReference"
          }
        }
      }
    },
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped"
          ]
        },
        "reason": {
          "type": "string"
        },
        "difference": {
          "type": "string"
        }
      }
    },
    "testSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "passed",
        "failed",
        "skipped"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "testGroupResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "stage",
        "group",
        "status",
        "source",
        "command",
        "summary",
        "cases",
        "evidence"
      ],
      "properties": {
        "schema": {
          "const": "ceratops-repository-stage-result.v1"
        },
        "stage": {
          "const": "tests"
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/stageStatus"
        },
        "source": {
          "$ref": "#/$defs/sourceIdentity"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "$ref": "#/$defs/testSummary"
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/testCase"
          }
        },
        "evidence": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "buildResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "artifact"
      ],
      "properties": {
        "schema": {
          "const": "ceratops-build-result.v1"
        },
        "status": {
          "$ref": "#/$defs/terminalStatus"
        },
        "artifact": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "artifact": {
                "$ref": "#/$defs/artifact"
              }
            }
          }
        }
      ]
    },
    "deploymentResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "target",
        "artifact"
      ],
      "properties": {
        "schema": {
          "const": "ceratops-deployment-result.v1"
        },
        "status": {
          "$ref": "#/$defs/terminalStatus"
        },
        "target": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "artifact": {
                "$ref": "#/$defs/artifact"
              }
            }
          }
        }
      ]
    }
  }
}
