{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ceratops.dev/schemas/ceratops-compatibility-contract.schema.json",
  "title": "Internal Ceratops compatibility contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_format_version", "kind", "description", "non_deterministic_review_file", "surfaces", "ci_required_arguments", "manifest_profiles", "generated_manifest_profile", "managed_skill_operations"],
  "properties": {
    "contract_format_version": {"const": 1, "description": "Executable: loader dispatch format."},
    "kind": {"const": "ceratops_compatibility_contract", "description": "Executable: loader identity check."},
    "description": {"type": "string", "minLength": 1, "description": "Annotation-only: internal scope and ownership."},
    "non_deterministic_review_file": {"$ref": "#/$defs/filename", "description": "Executable: loader validates the companion and reverse reference."},
    "surfaces": {
      "description": "Executable: generator destinations/templates and checker applicability/required files.",
      "type": "object",
      "additionalProperties": false,
      "required": ["validator", "workflow", "sdlc", "skill_manifest", "skill_bootstrap"],
      "properties": {
        "validator": {"$ref": "#/$defs/surface"},
        "workflow": {"$ref": "#/$defs/surface"},
        "sdlc": {"$ref": "#/$defs/surface"},
        "skill_manifest": {"$ref": "#/$defs/surface"},
        "skill_bootstrap": {"$ref": "#/$defs/surface"}
      }
    },
    "ci_required_arguments": {"$ref": "#/$defs/strings", "description": "Executable: checker requires these arguments on the CI validator invocation."},
    "manifest_profiles": {"$ref": "#/$defs/strings", "description": "Executable: checker and generator accept only these manifest profiles."},
    "generated_manifest_profile": {"type": "string", "minLength": 1, "description": "Executable: generator default; loader verifies it is accepted."},
    "managed_skill_operations": {
      "type": "object",
      "description": "Executable: generator supplies undeclared skill operations and removes only exact owned definitions when source skills disappear; loader validates against the SDLC schema.",
      "additionalProperties": false,
      "required": ["validate", "deploy-local"],
      "properties": {
        "validate": {"$ref": "#/$defs/operations"},
        "deploy-local": {"$ref": "#/$defs/operations"}
      }
    }
  },
  "$defs": {
    "strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "filename": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "template", "required"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path", "description": "Executable: repository-relative destination and checker target."},
        "template": {"$ref": "#/$defs/filename", "description": "Executable: trusted filename inside the bundle templates directory."},
        "required": {"enum": ["always", "with_skills", "when_present"], "description": "Executable: required-file condition within an applicable repository."}
      }
    },
    "operations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["handoff"],
            "properties": {"handoff": {"type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$", "description": "Executable: SDLC skill/action route supplied by the generator."}}
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["steps"],
            "properties": {
              "steps": {
                "type": "array",
                "minItems": 1,
                "description": "Executable: SDLC command sequence supplied by the generator.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["run"],
                  "properties": {"run": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "description": "Executable: command argv passed to the SDLC runner."}}
                }
              }
            }
          }
        ]
      }
    }
  }
}
