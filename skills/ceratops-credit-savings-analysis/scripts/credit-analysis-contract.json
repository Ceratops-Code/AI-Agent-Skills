    "transient-by-design",
    "permanently-implemented",
    "run-only-useful",
    "durable-control-missing",
    "final-state-unclear"
  ],
  "batch_controller_commands": [
    "prepare-batch",
    "advance-batch",
    "status-batch",
    "finalize-batch"
  ],
  "source_selectors": [
