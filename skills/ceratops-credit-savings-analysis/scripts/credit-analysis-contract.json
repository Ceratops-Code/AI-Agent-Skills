  "models": {
    "luna": "gpt-5.6-luna",
    "sol": "gpt-5.6-sol"
  },
  "model_reasoning_effort": {
    "luna": "max",
    "sol": "max"
  },
  "semantic_call_contract": {
    "luna_max_attempts": 50,
    "luna_max_concurrency": 10,
    "sol_target_calls": 5,
    "sol_max_calls": 6,
    "sol_adjudicator_target": 3,
    "sol_adjudicator_max": 4,
    "bookkeeping_calls": 0
  },
  "analysis_policy": {
    "implementation_status_source": "frozen-current-canonical-state",
    "existing_control_classification": "implemented-compliance-or-runtime-gap",
    "excluded_waste": [
      "intentional-full-skill-body-injection"
    ],
    "prohibited_recommendations": [
      "reasoning-settings-or-levels"
    ],
    "external_research": "targeted-official-sources-only",
    "broader_research_handoff": "paste-ready-prompt",
    "mutation_authority": false,
    "outstanding_finding_cap": null
  },
  "context_budget": {
    "utf8_bytes_per_token": 3.2,
    "hidden_prompt_reserve_tokens": 28000,
    "safety_margin_tokens": 12000,
    "visible_task_reserve_bytes": 64000,
    "luna_output_reserve_tokens": 4000,
    "sol_output_reserve_tokens": 48000,
    "minimum_evidence_tokens": 16000
  },
  "chunking": {
    "large_payload_inline_chars": 12000,
    "compact_text_chars": 900,
    "sol_evidence_chars_per_candidate": 6000
  },
  "coverage": {
    "maximum_unassessed_fraction": 0.2
  },
  "luna_candidate_kinds": [
    "provisional-finding",
    "plausible-risk",
    "temporary-control"
  ],
  "adjudication_dispositions": [
    "confirmed-finding",
    "plausible-risk",
    "dismissed-candidate"
  ],
  "temporary_control_dispositions": [
    "transient-by-design",
    "permanently-implemented",
    "run-only-useful",
    "durable-control-missing",
    "final-state-unclear"
  ],
  "batch_controller_commands": [
    "prepare-batch",
    "advance-batch",
    "status-batch",
    "finalize-batch"
  ],
  "source_selectors": [
    {
      "id": "current-thread",
